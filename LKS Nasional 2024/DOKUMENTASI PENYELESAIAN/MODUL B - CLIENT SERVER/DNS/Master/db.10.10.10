; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL	86400
@	IN	SOA	ns1.barat.id. admin.barat.id. (
		     2026080901		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			  86400 )	; Negative Cache TTL
;
@	IN	NS	ns1.barat.id.
@	IN	NS	ns2.barat.id.
10	IN	PTR	ns1.barat.id.
20	IN	PTR	ns2.barat.id.
10	IN	PTR	LINSRV1.barat.id.
20	IN	PTR	LINSRV2.barat.id.
10	IN	PTR	mail.barat.id.
20	IN	PTR	file.barat.id.
