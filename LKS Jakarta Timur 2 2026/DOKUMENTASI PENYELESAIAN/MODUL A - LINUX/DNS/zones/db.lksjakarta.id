;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	int.lksjakarta.id. root.lksjakarta.id. (
			     16		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	int.lksjakarta.id.

fw	IN	A	10.10.10.1
fw	IN	A	192.168.26.1
int	IN	A	10.10.10.10
mail	IN	A	192.168.26.10
web-01	IN	A	192.168.26.100
web-02	IN	A	192.168.26.200
ext-clt	IN	A	200.200.200.200

www	IN	A	200.200.200.100
vip	IN	A	192.168.26.123
vpn	IN	A	200.200.200.100
www.int	IN	CNAME	vip.lksjakarta.id.
@	IN	MX	10 mail.lksjakarta.id.
